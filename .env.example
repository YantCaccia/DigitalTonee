GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Livello di ragionamento di Gemini, opzionale (es. minimal, low): più basso = risposte più rapide
GEMINI_REASONING_EFFORT=
OWNER_NAME=Il tuo nome

# Modello di riserva se il principale è in 429/sovraccarico (vuoto = nessun riserva)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Limite globale di messaggi: un messaggio = 1-2 richieste a Gemini, quindi GLOBAL_RPM = metà dell'RPM del modello
GLOBAL_RPM=7
GLOBAL_RPD=300

# Foto per i deploy (il file assets/avatar.* non sta nel repo): base64 di un'immagine piccola
#   macOS:  base64 -i assets/avatar.jpg | tr -d '\n' | pbcopy
# AVATAR_B64=

# Interfaccia (opzionali)
DISPLAY_NAME=Il tuo nome
LINKEDIN_URL=

# Notifiche Telegram (opzionali: senza, i contatti vengono solo salvati in logs/)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Documenti: in locale stanno in data/*.md; su un deploy pubblico si passano come variabili (Secrets)
# CV_MD=
# LINKEDIN_MD=
# ABOUT_MD=
